   "source": [
    "import pandas as pd\n",
    "\n",
    "# Example dataset\n",
    "ages = [18, 20, 20, 21, 25]\n",
    "\n",
    "# Variance\n",
    "variance = pd.Series(ages).var()\n",
    "#Standard deviation\n",
    "std_dev = pd.Series(ages).std()\n",
    "\n",
    "print(\"Variance:\", variance)\n",
    "print(\"Standard Deviation:\", std_dev)\n"
   ]
